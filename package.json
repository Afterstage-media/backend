{
  "name": "medio-under-social-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp-stdio.js",
    "migrate:json": "node scripts/migrate-json-to-mongo.mjs",
    "users:upsert": "node scripts/upsert-user.mjs",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongodb": "^7.7.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

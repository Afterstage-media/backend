PORT=8787
NODE_ENV=production
ADMIN_TOKEN=cambiar-por-un-token-largo
# Opcional: usuarios adicionales. El token de ADMIN_TOKEN mantiene compatibilidad.
# AUTH_USERS_JSON=[{"id":"redaccion","token":"...","role":"editor"},{"id":"prensa","token":"...","role":"press"},{"id":"directorio","token":"...","role":"directory"},{"id":"comunidad","token":"...","role":"community"}]
AUTH_USERS_JSON=[]
JWT_SECRET=
JWT_ISSUER=medio-under
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=900
AUTH_ALLOW_LEGACY_BEARER=false
AUTH_ALLOW_LEGACY_API_KEY=false
RATE_LIMIT=120
TRUST_PROXY=false
MCP_ALLOW_LIVE_PUBLISH=false
MCP_ALLOW_LIVE_EMAIL=false
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
MEDIA_ROOT=/app/media

# Persistencia obligatoria de producción.
MONGODB_URI=
MONGODB_DB=medio_under
PUBLIC_BASE_URL=https://gestor.example.com
PUBLIC_MEDIA_BASE_URL=
CLOUDFLARE_TUNNEL_URL=
# Solo para el perfil named-tunnel del docker-compose (el compose lo lee desde el entorno del host).
CLOUDFLARE_TUNNEL_TOKEN=

# Proveedor OpenAI-compatible (OpenAI, OpenRouter, un gateway propio, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini

# Meta Graph API. El token debe ser de Page y de larga duración.
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_PAGE_ID=
META_API_VERSION=v24.0

# Seguridad: orígenes separados por coma. Vacío = mismo origen.
CORS_ORIGINS=
SCHEDULER_INTERVAL_MS=30000
# Fuentes RSS/Atom públicas separadas por coma para sumar eventos externos.
EVENTS_RSS_URLS=

# SMTP opcional para enviar solicitudes de acreditación desde el panel/MCP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PRESS_AUTO_FOLLOWUP=false
